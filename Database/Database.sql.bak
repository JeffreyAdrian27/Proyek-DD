CREATE TABLE CUSTOMER (
	ID_CUSTOMER NUMBER(3) PRIMARY KEY,
	NAMA_CUSTOMER VARCHAR2(20),
	ALAMAT VARCHAR(20),
	NO_TELP VARCHAR2(20)
);

CREATE TABLE KARYAWAN (
	ID_KARYAWAN NUMBER(3) PRIMARY KEY,
	NAMA_KARYAWAN VARCHAR2(20),
	USERNAME VARCHAR(20),
	PASSWORD VARCHAR2(20),
	STATUS NUMBER(1)
);

CREATE TABLE SPAREPART (
	ID_SPAREPART NUMBER(3) PRIMARY KEY,
	NAMA_SPAREPART VARCHAR2(20),
	STOK NUMBER(3),
	HARGA NUMBER(10),
	KETERANGAN VARCHAR2(255)
);

CREATE TABLE MODEL (
	ID_MODEL NUMBER(3) PRIMARY KEY,
	NAMA_MODEL VARCHAR2(20)
);

CREATE TABLE PRODUSEN (
	ID_PRODUSEN NUMBER(3) PRIMARY KEY,
	NAMA_PRODUSEN VARCHAR2(20)
);

CREATE TABLE HELM (
	ID_HELM NUMBER(3) PRIMARY KEY,
	NAMA_HELM VARCHAR2(255),
	ID_MODEL NUMBER(3),
	ID_PRODUSEN NUMBER(3),
	STOK NUMBER(10),
	HARGA NUMBER(10),
	ID_MODEL VARCHAR2(20) REFERENCES MODEL(ID_MODEL),
	ID_PRODUSEN VARCHAR2(20) REFERENCES PRODUSEN(ID_PRODUSEN)
	
);

CREATE TABLE TRANS_SERVIS (
	NO_TRANS_SERVIS VARCHAR2(20) PRIMARY KEY,
	NO_TRANS_JUAL VARCHAR2(20),
	ID_HELM NUMBER(10),
	TGL_SERVIS DATE,
	KETERANGAN VARCHAR2(255),
	BIAYA NUMBER(10),
	ID_HELM VARCHAR2(20) REFERENCES HELM(ID_HELM)
);
